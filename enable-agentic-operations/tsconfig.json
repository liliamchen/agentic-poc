{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    /* node：vite.config.ts 用 node:url 换算 __dirname。
       vite/client：页面模板的还原件会 `import img from './x.png'`，抄进来时需要这些模块声明。 */
    "types": ["node", "vite/client"],
    /* 只用 paths，不写已废弃的 baseUrl；路径相对本文件解析。 */
    "paths": {
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
